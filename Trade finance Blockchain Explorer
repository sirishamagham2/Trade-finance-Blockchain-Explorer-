from flask import Flask, render_template

app = Flask(__name__)

blocks = [
    {"index": 1, "sender": "Bank A", "receiver": "Exporter", "amount": "₹50,000", "status": "Approved"},
    {"index": 2, "sender": "Importer", "receiver": "Bank B", "amount": "₹75,000", "status": "Pending"},
    {"index": 3, "sender": "Bank C", "receiver": "Importer", "amount": "₹30,000", "status": "Completed"},
]

@app.route("/")
def home():
    return render_template("index.html", blocks=blocks)

if __name__ == "__main__":
    app.run(debug=True)
